# ---- Study Hub API ----------------------------------------------------------
# development | production | test   (production disables /docs, enables HSTS/CSP)
ENV=development

# Supabase Postgres via the SESSION pooler (IPv4-friendly; Render has no IPv6).
# Dashboard > Connect > Session pooler. Keep the +asyncpg driver prefix.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local: docker compose up -d db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/studyhub
# (Transaction pooler on port 6543 also works: prepared-statement caching is
#  switched off automatically for that port.)

# Supabase Auth: JWTs are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for legacy projects still signing with the shared HS256 secret:
SUPABASE_JWT_SECRET=

# Comma-separated; http://localhost:5173 is always allowed. First entry is used for email links.
FRONTEND_ORIGIN=https://study-hub.vercel.app

# Upstash Redis for rate limits (Upstash > Redis > Connect > "redis-py" URL).
# memory:// works for a single local process.
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379
TRUSTED_PROXY_HOPS=1

# AI: Gemini primary (aistudio.google.com/apikey), Groq fallback (console.groq.com/keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
AI_MAX_OUTPUT_TOKENS=4096

# Resend (resend.com) for streak-saver emails. Verify your sending domain first.
RESEND_API_KEY=
EMAIL_FROM=Study Hub <streaks@yourdomain.com>

# cron-job.org sends this as the X-Cron-Secret header to POST /internal/daily
CRON_SECRET=change-me-to-a-long-random-string

# Supabase user id of the shared demo account (Auth > Users). Seed: python -m app.demo.seed
DEMO_USER_ID=
